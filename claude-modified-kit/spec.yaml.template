# syntax=docker/sandbox-kit:3
schemaVersion: "3"
kind: mixin
displayName: gitlab-creds
version: "0.1.0"
description: >
  Read-only deploy token for the Claude config repo, and a separate glab token.
requires: ["claude"]

build: |
  FROM scratch
  COPY --chown=1000:1000 files/home/.local/bin/ /home/agent/.local/bin/

args:
  configRepoUrl:
    default: https://gitlab.com/<group>/<dotfiles-repo>.git
    env: CLAUDE_CONFIG_REPO_URL

capabilities:
  - type: com.docker.sandbox/network-policy@1
    config:
      runtime:
        allow:
          - gitlab.com
          - google.com
          - github.com
          - "*.github.com"
          - "*.githubusercontent.com"

  - type: com.docker.sandbox/credential@1
    optional: true
    description: GitLab token for glab inside the sandbox (PRIVATE-TOKEN on gitlab.com)
    config:
      service: gitlab-cli
      phase: runtime
      apiKey:
        name: GITLAB_CLI_TOKEN
        proxyManaged: true
        inject:
          - {domain: gitlab.com, header: PRIVATE-TOKEN, format: "%s"}

  - type: com.docker.sandbox/lifecycle@1
    config:
      startup:
        - command: ["bash", "-c", "bash /home/agent/.local/bin/sync-claude-config.sh || true; exec bash /home/agent/.local/bin/setup-claude-plugins.sh"]
          user: "1000"
          env: [CLAUDE_CONFIG_REPO_URL, GITLAB_CONFIG_REPO_B64]
          description: Sync ~/.claude from the dotfiles repo, then install plugins
        - command: ["bash", "/home/agent/.local/bin/glab-login.sh"]
          user: "1000"
          env: [GITLAB_CLI_TOKEN]
          description: Authenticate the glab CLI non-interactively
